# Normalise line endings so the build behaves the same on Windows, macOS, Linux and CI.
* text=auto

# Unix shell scripts must stay LF or they fail with "bad interpreter".
mvnw text eol=lf
name-sorter text eol=lf
*.sh text eol=lf

# Windows batch scripts must stay CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf